{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-havana-editor-debug",
      "type": "process",
      "command": "${workspaceFolder}/Tools/BuildProject.sh",
      "args": ["--project", "${workspaceFolder}", "Havana", "editor_debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build-player-game-debug",
      "type": "process",
      "command": "${workspaceFolder}/Tools/BuildProject.sh",
      "args": ["--project", "${workspaceFolder}", "Player", "game_linux_debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build-tests-game-debug",
      "type": "process",
      "command": "${workspaceFolder}/Tools/BuildProject.sh",
      "args": ["--project", "${workspaceFolder}", "MitchEngine_Tests", "game_linux_debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "generate-solution",
      "type": "process",
      "command": "${workspaceFolder}/GenerateSolution.sh",
      "args": ["--compile-commands"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
