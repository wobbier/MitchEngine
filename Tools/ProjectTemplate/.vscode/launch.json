{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Havana (Editor_Debug, Linux)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/Editor_Debug/Havana",
      "args": [],
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/Engine/Tools/NixGdb.sh",
      "miDebuggerArgs": "--project \"${workspaceFolder}\"",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "build-havana-editor-debug"
    },
    {
      "name": "Game (Debug, Linux)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/Game_linux_Debug/Game_EntryPoint_x64",
      "args": [],
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/Engine/Tools/NixGdb.sh",
      "miDebuggerArgs": "--project \"${workspaceFolder}\"",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "build-havana-game-debug"
    }
  ]
}
