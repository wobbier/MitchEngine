<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests for the CS-9 source generator, two ways:
      - driver tests host the generator on in-memory compilations (snapshots + diagnostics);
      - ScriptProbe is compiled by the generator in THIS project (the analyzer reference below),
        so its generated members run for real against ScriptCore.
    Build with the artifacts-path flag to keep bin/obj out of the tree (RunChecks does).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>annotations</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ScriptCore.csproj" />
    <ProjectReference Include="../Generators/MitchEngine.Generators.csproj" />
    <ProjectReference Include="../Generators/MitchEngine.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
