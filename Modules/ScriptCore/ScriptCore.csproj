<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Command-line build of ScriptCore (Linux and macOS, where Sharpmake can't generate C# projects,
    and the engine's own script builds). Visual Studio uses the Sharpmake-generated project.
    Build with: dotnet build ScriptCore.csproj -artifacts-path <scratch dir> (keeps bin/obj out of the tree).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ScriptCore</AssemblyName>
    <RootNamespace>ScriptCore</RootNamespace>
    <Nullable>annotations</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source/**/*.cs" />
    <!-- The host's runtime config travels with the DLLs, so an executable directory runs scripts
         without the source tree next to it (a cooked tree runs from anywhere). -->
    <None Include="../../Source/Scripting/ScriptCore.runtimeconfig.json" Link="ScriptCore.runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
