<rml>
<head>
	<title>HUD</title>
	<style>
		body {
			font-family: Inter;
			font-size: 20dp;
			color: #FFFFFF;
			width: 100%;
			height: 100%;
		}
		#coins {
			position: absolute;
			right: 24dp;
			top: 20dp;
			padding: 6dp 12dp;
			background-color: #00000090;
			border-radius: 4dp;
		}
	</style>
</head>
<body data-model="hud">
	<div id="coins">Coins {{ coins }}</div>
</body>
</rml>
