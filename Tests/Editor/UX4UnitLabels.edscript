# UX-4: every unit-tagged field shows its default in its unit (the metadata pass). One entity per
# component; each field is found by its inspector label and must read exactly as the unit formats it.
# Havana --scene Assets/Scenes/Tests/LightingTest.lvl --editor-exec Engine/Tests/Editor/UX4UnitLabels.edscript
wait 20

create ProbeAnimator
add-component Animator
select ProbeAnimator
wait 3
inspector-assert-shows Animator.Speed | 1
imgui-assert-value Animator/Speed | 1×

create ProbeAudioReverbZone
add-component AudioReverbZone
select ProbeAudioReverbZone
wait 3
inspector-assert-shows AudioReverbZone.MinDistance | 1
imgui-assert-value AudioReverbZone/Min Distance | 5 m
inspector-assert-shows AudioReverbZone.MaxDistance | 1
imgui-assert-value AudioReverbZone/Max Distance | 15 m

create ProbeAudioSource
add-component AudioSource
select ProbeAudioSource
wait 3
inspector-assert-shows AudioSource.Volume | 1
imgui-assert-value AudioSource/Volume | 0.0 dB
inspector-assert-shows AudioSource.Pitch | 1
imgui-assert-value AudioSource/Pitch | 0 st
inspector-assert-shows AudioSource.OcclusionAmount | 1
imgui-assert-value AudioSource/Occlusion Amount | 60%
inspector-assert-shows AudioSource.ReverbMix | 1
imgui-assert-value AudioSource/Reverb Mix | 100%
inspector-assert-shows AudioSource.MinDistance | 1
imgui-assert-value AudioSource/Min Distance | 1 m
inspector-assert-shows AudioSource.MaxDistance | 1
imgui-assert-value AudioSource/Max Distance | 50 m
inspector-assert-shows AudioSource.DopplerLevel | 1
imgui-assert-value AudioSource/Doppler Level | 1×

create ProbeBoxCollider2D
add-component BoxCollider2D
select ProbeBoxCollider2D
wait 3
inspector-assert-shows BoxCollider2D.EdgeRadius | 1
imgui-assert-value BoxCollider2D/Edge Radius | 0 m

create ProbeCamera
add-component Camera
select ProbeCamera
wait 3
inspector-assert-shows Camera.FieldOfView | 1
imgui-assert-value Camera/Field of View | 60°
inspector-assert-shows Camera.OrthographicSize | 1
imgui-assert-value Camera/Orthographic Size | 5 m
inspector-assert-shows Camera.Near | 1
imgui-assert-value Camera/Near Clip | 0.1 m
inspector-assert-shows Camera.Far | 1
imgui-assert-value Camera/Far Clip | 1000 m
inspector-assert-shows Camera.UpdateInterval | 1
imgui-assert-value Camera/Update Interval | 1 frames
inspector-assert-shows Camera.RenderScale | 1
# "Render Scale" is also the category tree above it.
imgui-assert-value Camera/Render Scale/Render Scale | 100%
inspector-assert-shows Camera.UpscaleSharpness | 1
imgui-assert-value Camera/Sharpness | 50%
inspector-assert-shows Camera.DynamicMinScale | 1
imgui-assert-value Camera/Minimum Scale | 50%
inspector-assert-shows Camera.DynamicTargetMs | 1
imgui-assert-value Camera/Target GPU ms | 16.6 ms

create ProbeCameraSway
add-component CameraSway
select ProbeCameraSway
wait 3
inspector-assert-shows CameraSway.Frequency | 1
imgui-assert-value CameraSway/Frequency | 0.18 Hz
inspector-assert-shows CameraSway.Handheld | 1
imgui-assert-value CameraSway/Handheld | 15%

create ProbeCapsuleCollider
add-component CapsuleCollider
select ProbeCapsuleCollider
wait 3
inspector-assert-shows CapsuleCollider.Radius | 1
imgui-assert-value CapsuleCollider/Radius | 0.5 m
inspector-assert-shows CapsuleCollider.Height | 1
imgui-assert-value CapsuleCollider/Height | 2 m

