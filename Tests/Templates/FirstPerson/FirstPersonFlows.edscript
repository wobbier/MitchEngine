# First-Person template regression (SHIP-6), run by RunChecks' "Templates" step on a project just
# created from Engine/Templates/FirstPerson with `Havana --new-project FirstPerson --name <Name>`:
#   Havana --project <new project> --editor-exec Engine/Tests/Templates/FirstPerson/FirstPersonFlows.edscript
# The editor builds the project's scripts; Play walks the player forward with a held key.
wait-log Project: | 60
wait 20

# A first open lands on the startup scene: the body, its eye camera and the course
assert-exists Player
assert-parent Main Camera | Player
assert-field Player | CharacterController.Height | 1.8
assert-exists Crate 6
assert-field Player | Transform.Position | [0.0, 1.0, -6.0] ~ 0.01

# Play: W (Move up) walks the body forward, towards +Z
# (anchored on state: the scripts may still be building when Play starts)
play
assert-playing 1
input-hold Keyboard/W
wait-field Player | Transform.Position.2 | != -6.0 ~ 2.0 | 900
input-release
assert-field Player | Transform.Position.0 | 0.0 ~ 0.25

# The starter kit (GAME-7): walking on picks up the key, the locked gate opens with Interact (E),
# and standing in the hazard by the crates drains the player's health until the checkpoint it
# walked over brings it back.
assert-exists Key
input-hold Keyboard/W
wait-field Player | Transform.Position.2 | != -6.0 ~ 5.0 | 900
wait 5
assert-missing Key
wait-field Player | Transform.Position.2 | 1.95 ~ 0.15 | 900
wait 10
assert-field Gate | Transform.Position.1 | 1.25 ~ 0.01
input-hold Keyboard/E
wait 3
input-release Keyboard/E
wait-field Gate | Transform.Position.1 | 3.85 ~ 0.05 | 300
wait-field Player | Transform.Position.2 | 6.0 ~ 0.4 | 900
input-release
wait-field Player | Transform.Position.2 | -4.0 ~ 0.3 | 900
stop
assert-field Player | Transform.Position | [0.0, 1.0, -6.0] ~ 0.01

# Play-mode tests (CS-12): the template's [GameTest]s (Assets/Scripts/Tests), each on a fresh Main.lvl.
play
assert-playing 1
wait 30
console game-tests
wait-log GameTests: 4 passed, 0 failed | 2400
stop
