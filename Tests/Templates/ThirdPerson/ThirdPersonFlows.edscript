# Third-Person template regression (SHIP-6), run by RunChecks' "Templates" step on a project just
# created from Engine/Templates/ThirdPerson with `Havana --new-project ThirdPerson --name <Name>`:
#   Havana --project <new project> --editor-exec Engine/Tests/Templates/ThirdPerson/ThirdPersonFlows.edscript
# The editor builds the project's scripts; Play steers the player with held keys.
wait-log Project: | 60
wait 20

# A first open lands on the startup scene: the hero, its visor, the follow camera and the course
assert-exists Player
assert-parent Visor | Player
assert-exists Main Camera
assert-exists Crate 6
assert-field Player | Transform.Position | [0.0, 1.0, -6.0] ~ 0.01

# Play: the fence behind the start stands between the follow camera and the hero, so it dithers
# away (OccluderFade, ME-284). Then W runs away from the camera (+Z), D to its right (+X), and the
# hero turns to face it (anchored on state: the scripts may still be building when Play starts)
play
assert-playing 1
wait-field Fence | Mesh.DitherFade | != 0.0 ~ 0.5 | 600
input-hold Keyboard/W
wait-field Player | Transform.Position.2 | != -6.0 ~ 2.0 | 900
input-release Keyboard/W
input-hold Keyboard/D
wait-field Player | Transform.Position.0 | != 0.0 ~ 2.0 | 600
input-release
assert-field Player | Transform.Rotation | != [0.0, 0.0, 0.0, 1.0]
stop
assert-field Player | Transform.Position | [0.0, 1.0, -6.0] ~ 0.01
