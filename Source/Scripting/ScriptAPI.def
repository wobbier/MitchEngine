## Entity lookup by scene GUID (the 16-hex string scenes and EntityRef fields store)
bool World_FindByGuid( cstr guid, Entity* outId )

## RmlUi data models (UI-3): script-owned view models for data-model documents. Values live
## engine-side, so they survive C# hot reloads; documents referencing a model reload when it
## first materializes. Events queue per model; scripts drain them each update.
bool UIModel_Ensure( cstr model )
void UIModel_SetNumber( cstr model, cstr key, double value )
void UIModel_SetString( cstr model, cstr key, cstr value )
void UIModel_RegisterEvent( cstr model, cstr key )
double UIModel_GetNumber( cstr model, cstr key )
int UIModel_GetString( cstr model, cstr key, byte* outValue, int size )
int UIModel_PollEvent( cstr model, byte* outName, int size )

## Player settings (PLAY-2): dotted keys over user://Settings.json ("Audio.Music", "Graphics.Quality",
## "Game.<yours>"), values as JSON text. Rebinds land in the game input and save with the settings.
int Settings_Get( cstr key, byte* outJson, int size )
bool Settings_Set( cstr key, cstr json )
bool Settings_Save()
void Settings_Reset()
bool Settings_Rebind( cstr action, int binding, cstr part, cstr control )
void Settings_ResetBindings()
int Settings_GetBindingDisplay( cstr action, int binding, byte* outText, int size )
int Settings_GetQualityPresets( byte* outNames, int size )

## UIDocument visibility by entity name (PLAY-3: menus such as the stock options menu).
## mode: 0 hide, 1 show, 2 toggle; false when no UIDocument entity has that name.
bool UI_SetDocumentVisible( cstr entityName, int mode )
bool UI_IsDocumentVisible( cstr entityName )

## Save games (PLAY-4): slots under user://Saves; a load is queued for the end of the frame.
bool SaveGame_Save( cstr slot, cstr name )
bool SaveGame_Load( cstr slot )
bool SaveGame_Delete( cstr slot )
int SaveGame_List( byte* outJson, int size )
bool SaveGame_IsWriting()
float SaveGame_GetPlaytime()

## Loading screens (PLAY-5): a main-scene load in the background under a loading document
## ("" = the project's LoadingDocument, "none" = no screen); progress is 0..1, 1 while idle.
bool World_LoadSceneAsync( cstr scene, cstr loadingDocument )
float World_GetLoadProgress()
bool World_IsLoadingScene()

## Localization (PLAY-6): string tables by key (Engine/Docs/Localization.md); a missing key returns itself.
int Loc_Get( cstr key, byte* outText, int size )
int Loc_GetLanguage( byte* outCode, int size )
int Loc_GetLanguages( byte* outCodes, int size )
