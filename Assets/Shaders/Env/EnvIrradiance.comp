// Diffuse irradiance (compute version of EnvIrradiance.frag): cosine-weighted average of the
// environment around the normal (E / pi), so Lambert shading is just albedo * this. One thread per
// texel; the face is the z group index. u_envFace: z destination size in texels, w sample count.
#include "bgfx_compute.sh"
#include "EnvMath.sh"

SAMPLERCUBE(s_envSource, 0);
IMAGE2D_ARRAY_WO(s_envDest, rgba16f, 1);

NUM_THREADS(8, 8, 1)
void main()
{
	float size = u_envFace.z;
	if (float(gl_GlobalInvocationID.x) >= size || float(gl_GlobalInvocationID.y) >= size)
	{
		return;
	}
	vec2 st = (vec2(gl_GlobalInvocationID.xy) + 0.5) / size;
	vec3 N = cubeFaceDirection(float(gl_GlobalInvocationID.z), st);
	vec3 t;
	vec3 b;
	tangentFrame(N, t, b);
	float count = u_envFace.w;
	vec3 sum = vec3_splat(0.0);
	for (int i = 0; i < 512; ++i)
	{
		if (float(i) >= count)
		{
			break;
		}
		vec2 xi = hammersley(float(i), count);
		float phi = 2.0 * ENV_PI * xi.x;
		float cosTheta = sqrt(1.0 - xi.y);
		float sinTheta = sqrt(xi.y);
		vec3 L = t * (sinTheta * cos(phi)) + b * (sinTheta * sin(phi)) + N * cosTheta;
		sum += envCubeLod(s_envSource, L, 0.0).rgb;
	}
	imageStore(s_envDest, ivec3(gl_GlobalInvocationID.xyz), vec4(sum / max(count, 1.0), 1.0));
}
