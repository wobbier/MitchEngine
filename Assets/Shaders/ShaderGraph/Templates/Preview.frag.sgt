$input v_texcoord0

// Shader graph editor preview for {{GRAPH}}: every node is evaluated, u_sgPreviewSelect picks
// what this draw shows. Constants read u_sgPreview[] so editing them needs no recompile.
{{DEFINES}}
#include "Common.sh"
#include "ShaderGraph/SGLib.sh"
#include "ShaderGraph/SGPreview.sh"
#if SG_TARGET_PARTICLE
SAMPLER2D(s_sgPreviewParticle, 6);
#define sgParticleTexture s_sgPreviewParticle
#endif

{{DECLARATIONS}}

void main()
{
	// u_sgPreviewSelect: x node output (-1: the graph's result), y 1 = sphere geometry.
	vec2 sgPv = v_texcoord0 * 2.0 - 1.0;
	sgPv.y = -sgPv.y;
	float sgR2 = dot(sgPv, sgPv);
	bool sgSphere = u_sgPreviewSelect.y > 0.5;
	vec3 sgN = sgSphere ? vec3(sgPv, sqrt(max(1.0 - sgR2, 0.0))) : vec3(0.0, 0.0, 1.0);
	vec3 sgP = sgSphere ? sgN * 0.5 : vec3(v_texcoord0.x - 0.5, 0.5 - v_texcoord0.y, 0.0);
	vec4 sg_fragCoord = gl_FragCoord;
{{LOCALS}}
{{BODY}}
	vec4 sgColor = vec4(0.0, 0.0, 0.0, 1.0);
{{SELECT}}
	if (sgSphere && sgR2 > 1.0)
	{
		sgColor = vec4(0.0, 0.0, 0.0, 0.0);
	}
	gl_FragColor = sgColor;
}
